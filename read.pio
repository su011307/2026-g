; Drive the AD9226 clock and capture GPIO26..GPIO39 in one operation.
; The state machine runs at twice the requested ADC sample rate:
;   instruction 0: rising edge, AD9226 samples the analog input
;   instruction 1: falling edge, capture data after the AD9226 output delay
.program read
.side_set 1

.wrap_target
    nop side 1
    in pins, 14 side 0
.wrap
