(* Beginning of Notebook Content *)
Notebook[{

Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fs", "=", 
    RowBox[{"65", "*", 
     RowBox[{"10", "^", "4"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"First", "@", 
    RowBox[{"Import", "[", 
     RowBox[{"\"\</home/shaoyafan/develop/wavegen/raw_adc.txt\>\"", 
      ",", "\"\<CSV\>\""}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", 
   RowBox[{"Length", "[", "data", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"data", "[", 
    RowBox[{"[", 
     RowBox[{"1", ";;", "n"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", "data", "]"}], "\n", 
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"MedianFilter", "[", 
    RowBox[{"data", ",", "7"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListLinePlot", "[", "data", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Max", "[", "data", "]"}], "-", 
  RowBox[{"Min", "[", "data", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"LowpassFilter", "[", 
    RowBox[{"data", ",", "550000", ",", "64", ",", 
     RowBox[{"SampleRate", "->", "65000000"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListLinePlot", "[", "data", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Max", "[", "data", "]"}], "-", 
  RowBox[{"Min", "[", "data", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fft", "=", 
   RowBox[{"Fourier", "[", "data", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"spectrum", "=", 
   RowBox[{"Abs", "[", "fft", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"freq", "=", 
   RowBox[{
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", 
      RowBox[{"n", "-", "1"}]}], "]"}], " ", 
    RowBox[{"fs", "/", "n"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"half", "=", 
   RowBox[{"Floor", "[", 
    RowBox[{"n", "/", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"freqHalf", "=", 
   RowBox[{"freq", "[", 
    RowBox[{"[", 
     RowBox[{"1", ";;", "half"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"specHalf", "=", 
   RowBox[{"spectrum", "[", 
    RowBox[{"[", 
     RowBox[{"1", ";;", "half"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"band", "=", 
   RowBox[{"Pick", "[", 
    RowBox[{
     RowBox[{"Range", "[", 
      RowBox[{"Length", "[", "freqHalf", "]"}], "]"}], ",", 
     RowBox[{"Thread", "[", 
      RowBox[{"10000", "<=", "freqHalf", "<=", "500000"}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"freqBand", "=", 
   RowBox[{"freqHalf", "[", 
    RowBox[{"[", "band", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"specBand", "=", 
   RowBox[{"specHalf", "[", 
    RowBox[{"[", "band", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{"Transpose", "[", 
   RowBox[{"{", 
    RowBox[{"freqBand", ",", "specBand"}], "}"}], "]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"peaks", "=", 
   RowBox[{"FindPeaks", "[", "specBand", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"peaksSorted", "=", 
   RowBox[{"Reverse", "@", 
    RowBox[{"SortBy", "[", 
     RowBox[{"peaks", ",", "Last"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"components", "=", 
   RowBox[{"Take", "[", 
    RowBox[{"peaksSorted", ",", 
     RowBox[{"UpTo", "[", "3", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"idx", "=", 
   RowBox[{"components", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "1"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"peakFreq", "=", 
   RowBox[{"freqBand", "[", 
    RowBox[{"[", "idx", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"peakAmplitude", "=", 
   RowBox[{"2", " ", 
    RowBox[{"specBand", "[", 
     RowBox[{"[", "idx", "]"}], "]"}], " ", 
    RowBox[{"Sqrt", "[", "n", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vpp", "=", 
   RowBox[{"2", " ", "peakAmplitude"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vrms", "=", 
   RowBox[{"peakAmplitude", "/", 
    RowBox[{"Sqrt", "[", "2", "]"}]}]}], ";"}], "\n", 
 RowBox[{"result", "=", 
  RowBox[{"Transpose", "[", 
   RowBox[{"{", 
    RowBox[{"peakFreq", ",", "vpp", ",", "vrms"}], "}"}], "]"}]}]}], "Input",
