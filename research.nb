Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"filteredSignal", ",", "spectrumAfter"}], "}"}], ",", 
     RowBox[{
      RowBox[{"filteredSignal", "=", 
       RowBox[{"LowpassFilter", "[", 
        RowBox[{"x", ",", "cutoff", ",", "filterLength", ",", 
         RowBox[{"SampleRate", "->", "fs"}], ",", 
         RowBox[{"Padding", "->", "\"\<Periodic\>\""}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"spectrumAfter", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"oneSidedSpectrum", "[", 
          RowBox[{"filteredSignal", ",", "fs"}], "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"First", "[", "#", "]"}], "<=", "1500000"}], "&"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ListLinePlot", "[", 
       RowBox[{"{", 
        RowBox[{"spectrumBefore", ",", "spectrumAfter"}], "}"}], "]"}]}]}], 
    "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "cutoff", ",", "700000", ",", "\"\<\:622a\:6b62\:9891\:7387/Hz\>\""}], 
      "}"}], ",", "550000", ",", "900000", ",", "10000"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"filterLength", ",", "201", ",", "\"\<FIR\:957f\:5ea6\>\""}], 
      "}"}], ",", "51", ",", "401", ",", "10"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.994280312246684*^9, 
  3.994280312246705*^9}},ExpressionUUID->"e247b6d1-eb93-4b33-b458-\
b7068e79a2f7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"hardCutoff", "=", "1000000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fullSpectrum", "=", 
   RowBox[{"Fourier", "[", 
    RowBox[{"x", ",", 
     RowBox[{"FourierParameters", "->", 
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"-", "1"}]}], "}"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"signedFrequency", "=", 
   RowBox[{
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", 
        RowBox[{
         RowBox[{"n", "/", "2"}], "-", "1"}]}], "]"}], ",", 
      RowBox[{"Range", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "n"}], "/", "2"}], ",", 
        RowBox[{"-", "1"}]}], "]"}]}], "]"}], " ", 
    RowBox[{"fs", "/", "n"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hardMask", "=", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"#", "<", "hardCutoff"}], ",", "1", ",", "0"}], "]"}], "&"}], 
     ",", 
     RowBox[{"Abs", "[", "signedFrequency", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"hardSpectrum", "=", 
   RowBox[{"fullSpectrum", " ", "hardMask"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xReconstructed", "=", 
   RowBox[{"Chop", "[", 
    RowBox[{"Re", "[", 
     RowBox[{"InverseFourier", "[", 
      RowBox[{"hardSpectrum", ",", 
       RowBox[{"FourierParameters", "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}]}], "}"}]}]}], "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{"Transpose", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Take", "[", 
      RowBox[{"t", ",", "samplesShown"}], "]"}], ",", 
     RowBox[{"Take", "[", 
      RowBox[{"xReconstructed", ",", "samplesShown"}], "]"}]}], "}"}], "]"}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.9942803279655533`*^9, 3.994280348799369*^9}},
 CellLabel->"In[96]:=",ExpressionUUID->"b056eee1-bfbd-4045-9027-7eba4abfa231"],

