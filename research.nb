Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fs", "=", "8000000"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"df", "=", "500"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"n", "=", 
    RowBox[{"fs", "/", "df"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"t", "=", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", 
        RowBox[{"n", "-", "1"}]}], "]"}], "/", "fs"}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f1", "=", "250000"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"f2", "=", "500000"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fNoise", "=", "1000000"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a1", "=", "0.050"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"a2", "=", "0.025"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"aNoise", "=", "0.100"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xUseful", "=", 
   RowBox[{
    RowBox[{"a1", " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"2", " ", "Pi", " ", "f1", " ", "t"}], "]"}]}], "+", 
    RowBox[{"a2", " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"2", " ", "Pi", " ", "f2", " ", "t"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xNoise", "=", 
   RowBox[{"aNoise", " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"2", " ", "Pi", " ", "fNoise", " ", "t"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x", "=", 
   RowBox[{"xUseful", "+", "xNoise"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"oneSidedSpectrum", "[", 
    RowBox[{"data_", ",", "sampleRate_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"length", ",", "spectrum", ",", "amplitude", ",", "frequency"}],
       "}"}], ",", 
     RowBox[{
      RowBox[{"length", "=", 
       RowBox[{"Length", "[", "data", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"spectrum", "=", 
       RowBox[{"Fourier", "[", 
        RowBox[{"data", ",", 
         RowBox[{"FourierParameters", "->", 
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{"-", "1"}]}], "}"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"amplitude", "=", 
       RowBox[{"2", " ", 
        RowBox[{"Abs", "[", 
         RowBox[{"Take", "[", 
          RowBox[{"spectrum", ",", 
           RowBox[{
            RowBox[{"length", "/", "2"}], "+", "1"}]}], "]"}], "]"}]}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"amplitude", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "=", 
       RowBox[{
        RowBox[{"amplitude", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "/", "2"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"amplitude", "[", 
        RowBox[{"[", 
         RowBox[{"-", "1"}], "]"}], "]"}], "=", 
       RowBox[{
        RowBox[{"amplitude", "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}], "/", "2"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"frequency", "=", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", 
          RowBox[{"length", "/", "2"}]}], "]"}], " ", 
        RowBox[{"sampleRate", "/", "length"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"frequency", ",", "amplitude"}], "}"}], "]"}]}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"samplesShown", "=", 
   RowBox[{"Round", "[", 
    RowBox[{"12", "*", 
     RowBox[{"10", "^", 
      RowBox[{"-", "6"}]}], " ", "fs"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{"Transpose", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Take", "[", 
      RowBox[{"t", ",", "samplesShown"}], "]"}], ",", 
     RowBox[{"Take", "[", 
      RowBox[{"x", ",", "samplesShown"}], "]"}]}], "}"}], "]"}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.994280236878364*^9, 3.9942802368783817`*^9}, {
